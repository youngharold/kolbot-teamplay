/**
 *  @filename    D2BotTeamLead.dbj
 *  @desc        TeamPlay LEADER entry. Runs SoloPlay's full OOG entry so we inherit
 *               SoloPlay's proven char-creation, auto-gearing, quest progression,
 *               AutoMule and town-chore machinery. TeamPlay bootstrap runs on top
 *               so team.json / TeamLogger / TeamStatus / TeamIPC are populated for
 *               future team-coordination logic (MVP-1+ builds on this base).
 *
 *               Philosophy: build on top of existing, working code. Don't reimplement
 *               things SoloPlay already does well.
 *
 *  @typedef {import("./sdk/globals")}
 */

// Delegate ALL OOG logic (login, char creation, game creation, town chores) to SoloPlay.
include("SoloPlay/OOG/SoloEntry.js");

// NOTE: SoloEntry.js's main loop doesn't return — it handles the OOG flow itself.
// TeamPlay-specific bootstrap (logger, state, IPC) is invoked FROM SoloPlay's flow
// via a TeamPlay hook that lives in libs/TeamPlay/ and is loaded by SoloPlay's own
// include chain later in the PR sequence. For now this .dbj exists so the profile
// has a distinct Entry value for D2Bot# — functionally equivalent to D2BotSoloPlay.dbj.
