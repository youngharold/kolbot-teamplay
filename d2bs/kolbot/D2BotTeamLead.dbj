/**
 *  @filename    D2BotTeamLead.dbj
 *  @desc        TeamPlay LEADER entry.
 *
 *               Loads TeamPlay's observability layer (logger, state, IPC, status)
 *               FIRST — that way team.json is initialized and log files open before
 *               SoloPlay takes over the OOG loop. Then delegates to SoloPlay's
 *               proven entry for login / char creation / game creation / town
 *               chores / AutoMule.
 *
 *               Philosophy: build on top of existing, working code. SoloPlay does
 *               90% of what we need at this layer — TeamPlay just adds team-wide
 *               observability + coordination primitives.
 *
 *  @typedef {import("./sdk/globals")}
 */

include("critical.js");

// --- TeamPlay observability bootstrap (runs BEFORE SoloPlay's OOG flow) ---
// Wrapped in try/catch so a TeamPlay bug can never wedge the bot. If bootstrap
// fails, the bot still runs as pure SoloPlay.
try {
	const TeamEntry = require("./libs/TeamPlay/OOG/TeamEntry");
	TeamEntry.bootstrap("lead");
	D2Bot.printToConsole("TeamPlay boot (Lead role)", sdk.colors.D2Bot.DarkGold);
} catch (e) {
	D2Bot.printToConsole("TeamPlay bootstrap failed: " + e.message, sdk.colors.D2Bot.Red);
}

// Delegate the full OOG lifecycle (login, char creation, game creation, town chores,
// AutoMule, TorchSystem, Gambling) to SoloPlay. SoloEntry.js enters its own main
// loop and doesn't return — TeamPlay coordination runs as kolbot threads alongside
// SoloPlay's flow (see libs/TeamPlay/Threads/*).
include("SoloPlay/OOG/SoloEntry.js");
